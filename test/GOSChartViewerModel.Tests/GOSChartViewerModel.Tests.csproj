<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <Platforms>AnyCPU;x86;x64;ARM64</Platforms>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>

  <!-- Versoes literais, como nos outros projetos de teste: o repositorio nao tem gestao central. Sem Avalonia: o
       GOSChartViewerModel e so LiveCharts e Skia. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GOSChartModel\GOSChartViewerModel.csproj" />
  </ItemGroup>

</Project>
